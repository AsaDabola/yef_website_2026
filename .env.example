# Postgres connection string. On Vercel this is the POSTGRES_URL that Vercel
# Postgres / Neon gives you; locally it can be any Postgres database.
DATABASE_URI=

# Any long random string. Payload signs admin sessions with it, so keep it
# secret and keep it stable — changing it logs everyone out.
PAYLOAD_SECRET=

# Only needed on Vercel, where the filesystem is read-only and uploaded images
# have to go to Blob storage. Leave empty locally and uploads land in
# public/media instead.
BLOB_READ_WRITE_TOKEN=
